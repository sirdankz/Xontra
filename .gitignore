# Contra NES-X: nothing of the game is ever committed. You put your own
# cartridge here as baserom.nes; setup.py fetches the disassembly and makes
# the rest locally.

# --- the game, in any form ----------------------------------------------------
# cartridges (baserom.nes among them), the port's save states
*.nes
*.fds
*.unf
*.unif
*.rom
*.bin
*.chr
*.prg
*.sta
*.sav
# the disassembly's sources, cc65's objects, listings and debug symbols
*.asm
*.lst
*.sym
*.dbg
*.map
*.nl
# screenshots, the icons taken from the game, its sound
*.png
*.bmp
*.gif
*.wav
*.mp3

# --- fetched and generated by setup.py ----------------------------------------
# the disassembly and cc65, at their pinned revisions
/extern/
# ca65, ld65, hosttest, the assembled cartridge, the icon screenshot
/build/
# the disc's data folder: the cartridge
/data/
# the dashboard icons
/Platform/xbox/gen/

# --- build output -------------------------------------------------------------
/out/
# Visual Studio's build: its output, and its intermediates under the project name
/Xbox/
/Contra-NES-X/
/.vs/
*.vcxproj.user
*.iso
*.xbe
*.xbx
*.exe
*.obj
*.o
*.pdb
*.ilk
__pycache__/

# --- release notes, kept local -----------------------------------------------
*.nfo

# Local work, archives, backups, and credentials
/work/
/outputs/
*.zip
*.7z
*.rar
*.bak
*.old
*~
.env
.env.*
*.pem
*.key
*.pfx
*.p12
*.pyc
*.pyo
