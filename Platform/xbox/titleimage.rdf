// Original Xontra title icon (128x128), generated by tools/xbox/make_icons.py.
// Contains no cartridge artwork. RXDK bundles it as a DXT1 XPR resource.

out_version        XPR0
out_packedresource gen/titleimage.xbx
out_header         gen/titleimage.h

Texture TitleImage
{
   Source gen/titleimage.bmp
   Format D3DFMT_DXT1
   Levels 1
}
